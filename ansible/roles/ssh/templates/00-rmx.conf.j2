# Managed by ansible (rmx-vps): roles/ssh. Read before every other sshd
# setting, so these win. Exceptions: the Match blocks in /etc/ssh/sshd_config.
PubkeyAuthentication yes
PasswordAuthentication no
KbdInteractiveAuthentication no
PermitRootLogin no
X11Forwarding no
# Only these may log in at all; root only from the provider dashboard.
AllowUsers {{ admin_user }} deploy{{ ' ci' if vault_ci_ssh_key | default('') | length > 0 else '' }} root@{{ dashboard_ip }}

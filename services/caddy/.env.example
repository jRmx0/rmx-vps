# Copy to .env on the server (root, mode 0600). Never commit .env.
# Basic auth for https://api.rmx.lt/probe/ (see README §10 "Probe").
# Make the hash (the password is read from stdin, so it isn't in the shell history):
#   docker compose exec caddy caddy hash-password
# Keep the single quotes: the bcrypt hash contains "$" signs.
PROBE_AUTH_USER=probe
PROBE_AUTH_HASH='$2a$14$replace-with-the-output-of-caddy-hash-password'

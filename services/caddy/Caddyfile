# Global options
{
	# HTTP/1.1 and HTTP/2 only. HTTP/3 would need 443/udp, which we don't open.
	servers {
		protocols h1 h2
	}
	# Let's Encrypt only, no ZeroSSL fallback: the mower probe trusts only ISRG
	# Root X1/X2 (rmx-mower-modem-probe certs/rmx-ca-bundle.pem). A certificate
	# from another CA would cut it off, including from OTA fixes.
	cert_issuer acme {
		dir https://acme-v02.api.letsencrypt.org/directory
	}
}

# Main site: placeholder page
rmx.lt {
	root * /srv/site
	file_server
	encode zstd gzip
}

# API: placeholder until the app container exists
api.rmx.lt {
	# rmx-backend-probe (Compose profile "probe"). The prefix is kept: the app
	# serves /probe/... itself, including its own login: a session cookie
	# checked by the app on the API, /probe/ws and /probe/config.json (its
	# README, "Login and sessions"). Only /probe/health, login/logout and the
	# static page (public code, no data) work without a session.
	# Caddy adds no auth of its own any more (basic auth broke WebSockets on
	# iPhones). Still closed by default: when the probe is off, probe-app
	# doesn't resolve and Caddy answers 502, so nothing under /probe is open.
	# Caddy passes Cookie and Origin through and sets X-Forwarded-For to the
	# real client IP (it ignores one sent by the client), which the app's
	# login rate limit uses.
	@probe path /probe /probe/*
	handle @probe {
		reverse_proxy probe-app:8080
	}

	# Firmware images for OTA updates of the LTE modem board
	# (rmx-mower-modem-probe): GET /fw/probe/<version>.bin, read-only from
	# caddy/firmware/ on the host. HTTP basic auth, one login per device; the
	# logins (bcrypt hashes) are server only in caddy/private/fw-users.caddy
	# (template: fw-users.caddy.example). That file must exist or Caddy won't
	# start; an empty one locks /fw/ (401 for everyone). The images are signed
	# and the device checks the signature, so the login only keeps casual
	# downloads away. Range requests work (the device resumes a dropped
	# download); no directory listings (404).
	@fw path /fw/*
	handle @fw {
		basic_auth {
			import private/fw-users.caddy
		}
		root * /srv
		file_server
	}

	handle {
		header Content-Type application/json
		respond `{"service":"rmx-api","status":"placeholder"}` 200
	}
}

# www -> bare domain (301, keeps the path)
www.rmx.lt {
	redir https://rmx.lt{uri} permanent
}

# MQTT broker name. Caddy only obtains and renews the TLS certificate here;
# a host timer copies it to Mosquitto (see services/mosquitto/cert-sync/).
# MQTT itself is on port 8883, served by Mosquitto, not by Caddy. No MQTT
# goes through Caddy: browsers don't speak MQTT (removed 2026-10-20).
mqtt.rmx.lt {
	respond "MQTT broker: mqtts://mqtt.rmx.lt:8883 (TLS)" 200
}

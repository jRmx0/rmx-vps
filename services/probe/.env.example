# Copy to .env on the server (root, mode 0600) and fill in. Never commit .env.
# Generate a password: openssl rand -base64 48 | tr -dc 'A-Za-z0-9' | head -c 32
# Letters and digits only: the DB password goes into a URL (DATABASE_URL).

# TimescaleDB user "probe" (used by probe-db and probe-app)
PROBE_DB_PASSWORD=change-me

# Mosquitto login "probe-app" (same value as in mosquitto/data/credentials.txt)
PROBE_MQTT_PASSWORD=change-me

# The deployed image tag. Rewritten by /usr/local/sbin/rmx-deploy-probe;
# change it only through that script (sudo rmx-deploy-probe sha-xxxxxxx).
PROBE_TAG=sha-11543a3

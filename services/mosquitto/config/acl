# Mosquitto access rules (ACL). Anything not allowed here is denied.
# This file is the source; Mosquitto reads an installed copy. After editing:
#   sudo install -o 1883 -g 1883 -m 0600 config/acl data/auth/acl
#   docker compose kill -s HUP mosquitto
#
# Topics per mower (<id> = the mower's username, e.g. mower-01):
#   mower/<id>/telemetry   mower -> server
#   mower/<id>/status      mower -> server, retained, also the last-will ("offline")
#   mower/<id>/cmd         server -> mower (command with ID and expiry)
#   mower/<id>/cmd/ack     mower -> server

# The backend app: every mower's topics.
user app
topic readwrite mower/#

# Every login (each mower): only its own subtree. %u = the username,
# so a new mower needs a login only, no change in this file.
pattern readwrite mower/%u/#

# --- rmx-backend-probe (see README §10 "Probe") ---------------------------
# Topics: probe/req/<client-id> (device -> server), probe/res/<client-id>
# (server -> device), probe/events/records, probe/status/server (retained).
# The probe server: all of probe/.
user probe-app
topic readwrite probe/#

# The ESP32 probe device (rmx-mower-modem-probe, LTE, 8883 only so the client
# id is always "probe-device"): only its own request/response pair, plus the
# shared events and server status.
user probe-device
topic write probe/req/probe-device
topic read probe/res/probe-device
topic read probe/events/#
topic read probe/status/#
